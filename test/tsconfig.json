{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2023"],
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "Node16",
    "alwaysStrict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "strict": true,
    "skipLibCheck": true,
    "strictNullChecks": true
  },
  "include": ["./**/*.ts"],
  "ts-node": {
    "esm": true
  }
}
