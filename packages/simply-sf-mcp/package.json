{
  "name": "@simplysf/simply-sf-mcp",
  "description": "An MCP server that exposes SimplySF Salesforce tooling to coding agents",
  "version": "0.0.0",
  "author": "@ClayChipps",
  "homepage": "https://github.com/SimplySF/simply-plugins",
  "bugs": "https://github.com/SimplySF/simply-plugins/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimplySF/simply-plugins",
    "directory": "packages/simply-sf-mcp"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "simply-sf-mcp": "./bin/run.js"
  },
  "files": [
    "/bin",
    "/lib",
    "/messages"
  ],
  "keywords": [
    "force",
    "salesforce",
    "sfdx",
    "salesforcedx",
    "mcp",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "exports": "./lib/index.js",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@salesforce/core": "^8.30.0",
    "@simplysf/simply-aep-core": "^0.15.1",
    "@simplysf/simply-apex-core": "^0.3.11",
    "@simplysf/simply-core": "^1.6.7",
    "@simplysf/simply-package-core": "^0.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "wireit",
    "compile": "wireit",
    "fix-license": "eslint src test --fix --rule \"header/header: [2]\"",
    "format": "wireit",
    "lint": "wireit",
    "test": "wireit",
    "test:coverage": "vitest run --coverage --project simply-sf-mcp",
    "test:only": "wireit",
    "test:watch": "vitest watch --project simply-sf-mcp",
    "tool-snapshot": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "tool-snapshot",
        "compile",
        "lint"
      ]
    },
    "compile": {
      "command": "tsc -p . --pretty --incremental",
      "files": [
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": [
        "lib/**",
        "*.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "tool-snapshot": {
      "command": "node scripts/tool-snapshot.mjs",
      "dependencies": [
        "compile"
      ],
      "files": [
        "lib/**/*.js",
        "messages/**",
        "scripts/tool-snapshot.mjs",
        "../../.prettierrc.mjs"
      ],
      "output": [
        "test/tool-snapshot.json"
      ]
    },
    "format": {
      "command": "prettier --write \"+(src|test)/**/*.+(ts|js|json)\"",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        ".prettier*"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint src test --color --cache --cache-location .eslintcache",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "**/.eslint*",
        "**/tsconfig.json",
        "../../eslint.config.mjs",
        "../../tsconfig.json"
      ],
      "output": []
    },
    "test": {
      "dependencies": [
        "test:compile",
        "test:only",
        "lint"
      ]
    },
    "test:compile": {
      "command": "tsc -p \"./test\" --pretty",
      "files": [
        "test/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": []
    },
    "test:only": {
      "command": "vitest run --project simply-sf-mcp",
      "dependencies": [
        "compile"
      ],
      "env": {
        "FORCE_COLOR": "2"
      },
      "files": [
        "test/**/*.ts",
        "test/**/*.json",
        "src/**/*.ts",
        "messages/**",
        "**/tsconfig.json",
        "../../tsconfig.json",
        "vitest.config.ts"
      ],
      "output": []
    }
  }
}
